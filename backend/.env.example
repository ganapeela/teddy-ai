# Teddy AI - Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./teddy_ai.db

# LLM Reasoning Engine (Gemini API)
# Get your free or paid key at https://aistudio.google.com/
# If left empty, Teddy AI automatically runs in Veteran Deterministic Fallback Mode!
GEMINI_API_KEY=

# Broker Integration (Optional: MOCK | DHAN | ZERODHA | UPSTOX)
BROKER_NAME=MOCK
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
